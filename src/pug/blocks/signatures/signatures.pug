mixin signatures
  section.signatures
    .signatures__inner.container
      .signatures__body
        .signatures__title.title-medium
          h2.signatures__title-text Пакеты цифровых подписей 
        ul.signatures__list
          li.signatures__item
            .signatures__item-title.title-small
              h3.signatures__item-h3 Demo
            .signatures__item-description
              p.signatures__item-text
                |30 документів
              .signatures__item-price
                p.price-large.title-medium
                  |0
                p.price-text
                  |грн/місяць
            .signatures__button    
              +button('ЗАРЕГИСТРИРОВАТЬСЯ', 'button', 'btn btn--blue btn--current') 
          li.signatures__item
            .signatures__item-title.title-small
              h3.signatures__item-h3 Business
            .signatures__item-description
              p.signatures__item-text
                |30 документів
              .signatures__item-price
                p.price-large.title-medium
                  |1 000
                p.price-text
                  |грн/місяць
            .signatures__button  
              +button('ЗАКАЗАТЬ', 'button', 'btn btn--blue btn--current') 
          li.signatures__item
            .signatures__item-title.title-small
              h3.signatures__item-h3 Pro
            .signatures__item-description
              p.signatures__item-text
                |30 документів
              .signatures__item-price
                p.price-large.title-medium
                  |9 000
                p.price-text
                  |грн/місяць
            .signatures__button  
              +button('ЗАКАЗАТЬ', 'button', 'btn btn--blue btn--current') 
          li.signatures__item
            .signatures__item-title.title-small
              h3.signatures__item-h3 Individual
            .signatures__item-description
              p.signatures__item-text
                |Необмежена кількість документів
              .signatures__item-price
              .signatures__button  
                +button('СВЯЗАТЬСЯ С НАМИ ', 'button', 'btn btn--blue btn--current')     