mixin signatures
  section.signatures
    .signatures__inner.container
      .signatures__body
        .signatures__title.title-medium
          h2.signatures__title-text Пакеты цифровых подписей 
        ul.signatures__list
          li.signatures__item
            .signatures__item-title.title-small
              //FIXME: Шашлык не по БЭМ
              h3.signatures__item-title-text Demo
            .signatures__item-description
              p.signatures__item-description-text
                |30 документів
              //FIXME: Шашлык не по БЭМ
              .signatures__item-description-price
                p.price-large
                  |0
                p.price-text
                  |грн/місяць
            button.signatures__item-button.button.button-color ЗАРЕГИСТРИРОВАТЬСЯ
          li.signatures__item
            .signatures__item-title.title-small
              //FIXME: Не по БЭМ
              h3.signatures__item-title-text Business
            .signatures__item-description
              p.signatures__item-description-text
                |30 документів
              .signatures__item-description-price
                p.price-large
                  |1 000
                p.price-text
                  |грн/місяць
            //FIXME: В Миксин
            button.signatures__item-button.button.button-color ЗАКАЗАТЬ
          //FIXME: Править шашлыки
          li.signatures__item
            .signatures__item-title.title-small
              h3.signatures__item-title-text Pro
            .signatures__item-description
              p.signatures__item-description-text
                |30 документів
              .signatures__item-description-price
                p.price-large
                  |9 000
                p.price-text
                  |грн/місяць
            //FIXME: В миксин
            button.signatures__item-button.button.button-color ЗАКАЗАТЬ
          li.signatures__item
            .signatures__item-title.title-small
              h3.signatures__item-title-text Individual
            .signatures__item-description
              p.signatures__item-description-text
                |Необмежена кількість документів
              .signatures__item-description-price
              button.signatures__item-button.button.button-color СВЯЗАТЬСЯ С НАМИ      