mixin main-advantages
  section.main__advantages
    .main__advantages-inner.container
      ul.main__advantages-list
        li.main__advantages-item
          .main__advantages-body
            .main__advantages-title
              h3.main__advantages-h3 Моментально
            .main__advantages-text
              p
              | Никаких задержек. <br> 1 секунда на подписание
          img.main__advantages-image(src='./images/speedometer.svg', alt='speedometer')
        li.main__advantages-item
          .main__advantages-body
            .main__advantages-title
              h3.main__advantages-h3 Глобально
            .main__advantages-text
              p
              | Сервис доступен 24\7 <br>со всех устройств
          img.main__advantages-image(src='./images/positive-vote.svg', alt='positive-vote')
        li.main__advantages-item
          .main__advantages-body
            .main__advantages-title
              h3.main__advantages-h3 Экономно
            .main__advantages-text
              p
              | В 30 раз дешевле чем <br> почта и курьеры
          img.main__advantages-image(src='./images/piggy-bank.svg', alt='piggy-bank')
