mixin main-advantages
  section.main__advantages
    .main__advantages-inner.container
      ul.main__advantages-list
        li.main__advantages-item
          .main__advantages-item-body
            .main__advantages-item-title
              h3.main__advantages-item-title-text Моментально
            .main__advantages-item-text
              p
              | Никаких задержек. <br> 1 секунда на подписание
          img.main__advantages-item-image(src="./images/speedometer.svg" alt="speedometer")
        li.main__advantages-item
          .main__advantages-item-body
            .main__advantages-item-title
              h3.main__advantages-item-title-text Глобально
            .main__advantages-item-text
              p
              | Сервис доступен 24\7 <br>со всех устройств
          img.main__advantages-item-image(src="./images/positive-vote.svg" alt="positive-vote")
        li.main__advantages-item
          .main__advantages-item-body
            .main__advantages-item-title
              h3.main__advantages-item-title-text Экономно
            .main__advantages-item-text
              p
              | В 30 раз дешевле чем <br> почта и курьеры
          img.main__advantages-item-image(src="./images/piggy-bank.svg" alt="piggy-bank")

